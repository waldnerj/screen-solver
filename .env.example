# Variante 1 – Gemini (kostenloser Key von https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Variante 2 – Ollama (läuft lokal, kein Key nötig): GEMINI_API_KEY leer lassen
# OLLAMA_MODEL=gemma3:4b

# Variante 3 – Anthropic (kostenpflichtig)
# ANTHROPIC_API_KEY=

# Optional: stärkeres, etwas langsameres Gemini-Modell
# GEMINI_MODEL=gemini-flash-latest

# Optional: Deckkraft des Overlays, 0.15 (fast durchsichtig) bis 1 (deckend)
# OVERLAY_OPACITY=0.5
